# infra/envs/dev/infra/terraform.tfvars.example
# 민감 정보(db_username, db_password)는 환경변수로 주입
#   export TF_VAR_db_username="matnani"
#   export TF_VAR_db_password="..."

# ──────────── RDS ────────────
db_instance_class   = "db.t4g.micro"
create_read_replica = false

# ──────────── ElastiCache ────────────
redis_node_type = "cache.t4g.micro"
redis_num_nodes = 1
